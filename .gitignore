# ---------------------------------------------------------------------------
# Media - these are the program's OUTPUT, not source. Individual clips run to
# hundreds of MB, well past GitHub's hard 100 MB per-file limit.
# ---------------------------------------------------------------------------
Videos/
output/
*.mp4
*.mkv
*.webm
*.m4a
*.wav
*.part
*.ytdl

# ---------------------------------------------------------------------------
# Virtual environments (~300 MB, and machine-specific)
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Generated knowledge graphs.
# Regenerate with: graphify <path> --code-only && graphify cluster-only <path>
# Delete these lines if you'd rather publish graph.html with the repo.
# ---------------------------------------------------------------------------
graphify-out/

# ---------------------------------------------------------------------------
# Machine-specific editor and tooling config
# ---------------------------------------------------------------------------
.vscode/
.claude/
.idea/

# ---------------------------------------------------------------------------
# Model caches
# ---------------------------------------------------------------------------
.cache/
*.bin
*.onnx

# ...except the face detection model, which is only 227 KB and ships with the
# repo so nobody has to download it separately.
!ClipCaptioner/models/*.onnx

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store

# ---------------------------------------------------------------------------
# Training data for the local fight detector
# ---------------------------------------------------------------------------
# Source footage is tens of gigabytes and re-downloadable from the ids recorded
# in config.py.
EsportsClipper/data/reels/
EsportsClipper/data/broadcasts/

# Feature caches are derived: about 25 minutes of CPU rebuilds one from its
# video, and they are tied to a schema version that changes whenever a feature
# does.
EsportsClipper/data/features/

# The trained model is kept - it is small, and without it the detector cannot
# run at all. Its card records what it was trained on and how it scored.
!EsportsClipper/models/

# Intermediate output from a detection run - rebuilt every time, and only
# meaningful for the broadcast that produced it.
EsportsClipper/data/candidates.json
EsportsClipper/data/final_segments.json

# The synthetic self-test's model. It learned invented data and knows nothing
# about a real fight; local_detector refuses to load it on purpose.
EsportsClipper/models/synthetic/

# Stock footage fetched from Pexels. Re-downloadable from the topic name, and
# a library of it grows well past what belongs in a repo.
ClipCaptioner/stock/

# The local title model - 2.6 GB, and re-downloadable from the id in config.py.
# The face-detection model above stays tracked because it is 227 KB and the
# renderer cannot work without it; this one is a different order of magnitude.
ClipCaptioner/models/phi35/
